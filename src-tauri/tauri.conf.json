{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZMapa",
  "version": "0.3.5",
  "identifier": "com.ezmapa.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EZMapa",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4N0E5OEFDNUM4QzZDRTIKUldUaWJJeGNySmg2R0syMlpudWl1RG5sd0dVZUFYSTRZYk1WbHYrYUhBd0pvYm43UFhxaUVzYjkK",
      "endpoints": [
        "https://github.com/innvandrer/mcLauncher/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "EZMapa — a modern Minecraft launcher",
    "longDescription": "EZMapa is a modern Minecraft launcher: manage isolated instances, install mods and modpacks from Modrinth and CurseForge, sign in with your Microsoft account, and launch the game with the right Java version automatically.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
